\par     \{
\par         struct mbuf_pool_box *box = &mbuf_pool[i];
\par 
\par         box->magic_start = MBUF_POOL_MAGIC_START;
\par         box->magic_end   = MBUF_POOL_MAGIC_END;
\par 
\par         box->in_use = 0;
\par 
\par         memset(&box->mbuf, 0, sizeof(box->mbuf));
\par 
\par         box->next = mbuf_free_list;
\par         mbuf_free_list = box;
\par     \}
\par 
