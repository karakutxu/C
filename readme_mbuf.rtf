\par      * Clear application state before returning the
\par      * object to the pool.
\par      */
\par     memset(m, 0, sizeof(*m));
\par 
\par     box->in_use = 0;
\par 
\par     /*
\par      * Put the object back onto the free list.
\par      */
\par     box->next = mbuf_free_list;
\par     mbuf_free_list = box;
\par 
\par     mbuf_available++;
\par \}
