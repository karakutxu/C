\par         return NULL;
\par     \}
\par 
\par     box = mbuf_free_list;
\par 
\par     if (!box)
\par     \{
\par         fprintf(stderr,
\par                 "mbuf_alloc: mbuf pool exhausted\\n");
\par         return NULL;
\par     \}
\par 
\par     /*
\par      * Check allocator bookkeeping before handing
\par      * the object to the application.
\par      */
\par     if (box->magic_start != MBUF_POOL_MAGIC_START ||
\par         box->magic_end != MBUF_POOL_MAGIC_END)
\par     \{
\par         fprintf(stderr,
\par                 "mbuf_alloc: pool corruption detected\\n");
\par         return NULL;
\par     \}
\par 
\par     if (box->in_use)
\par     \{
\par         fprintf(stderr,
\par                 "mbuf_alloc: object already marked in use\\n");
\par         return NULL;
\par     \}
\par 
\par     /*
\par      * Remove from free list.
\par      */
\par     mbuf_free_list = box->next;
\par 
\par     /*
\par      * Mark as allocated.
\par      */
\par     box->in_use = 1;
\par 
\par     /*
\par      * Clear the entire mbuf before giving it to the caller.
\par      */
\par     memset(&box->mbuf, 0, sizeof(box->mbuf));
