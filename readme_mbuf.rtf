\par void mbuf_free(struct mbuf *m)
\par \{
\par     struct mbuf_pool_box *box;
\par 
\par     if (!m)
\par         return;
\par 
\par     box = mbuf_box_from_mbuf(m);
\par 
\par     /*
\par      * Check that the object still belongs to our pool.
\par      */
\par     if (box->magic_start != MBUF_POOL_MAGIC_START ||
\par         box->magic_end != MBUF_POOL_MAGIC_END)
\par     \{
\par         fprintf(stderr,
\par                 "mbuf_free: invalid/corrupted mbuf\\n");
\par         return;
\par     \}
\par 
\par     /*
\par      * Detect double free.
\par      */
\par     if (!box->in_use)
\par     \{
\par         fprintf(stderr,
\par                 "mbuf_free: double free detected\\n");
\par         return;
\par     \}
\par 
\par     /*
\par      * The mbuf must no longer own any external packet
\par      * buffer when it comes back into the pool.
\par      *
\par      * At Stage 1 the packet data is still allocated
\par      * separately, so that must be freed here.
