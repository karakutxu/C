\par \{
\par     MsgSetProtoDrvrMtu_t msg;
\par 
\par     memset(&msg, 0, sizeof(msg));
\par 
\par     msg.id = MSG_SET_PROTO_DRV_MTU;
\par     msg.mtu = mtu;
\par 
\par     return msg;
\par \}
\par Test:
\par static void test_set_proto_drvr_mtu(void)
\par \{
\par     MsgSetProtoDrvrMtu_t msg;
\par 
\par     printf("\\n");
\par     printf("----------------------------------------\\n");
\par     printf("TEST: MSG_SET_PROTO_DRV_MTU\\n");
\par     printf("----------------------------------------\\n");
\par 
\par     msg = mf_set_proto_drvr_mtu(TEST_MTU);
\par 
\par     if (send_all(g_test.pme_fd, &msg, sizeof(msg)) < 0)
\par         fail_test("Failed to send MSG_SET_PROTO_DRV_MTU");
\par 
\par     pass_step("MSG_SET_PROTO_DRV_MTU sent from mock PME");
\par 
\par     /*
\par      * No response is defined by the production protocol.
\par      * Verify ifp->if_mtu through the test instrumentation.
\par      */
\par \}
